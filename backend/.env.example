# ==========================================
# Core Application Configuration
# ==========================================
NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://localhost:27017/food_delivery_db
CLIENT_URL=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

# ==========================================
# Security & JWT Secrets
# ==========================================
# Generate 64-char secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_example
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security (false in local dev if not using HTTPS; true in production)
COOKIE_SECURE=false
# Cookie SameSite: 'lax', 'strict', or 'none' (use 'none' only if frontend is on different domain with COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax

# ==========================================
# Optional Integrations (Disabled by default)
# Startup proceeds smoothly if left blank or unset
# ==========================================

# AI Capabilities (e.g., 'gemini', 'openai', or 'mock')
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Maps & Geolocation
MAPS_API_KEY=

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
